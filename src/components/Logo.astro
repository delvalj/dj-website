---
// Logo de KAS:ST en la cabecera. Usa el primero que exista:
// 1. src/assets/logo.svg: logo vectorial (el ideal). Debería usar fill="currentColor" para pintarse en verde.
// 2. src/assets/logo-wordmark.png: el texto "KAS:ST" recortado de logo.png (PNG negro con fondo transparente).
//    Se usa como máscara: la forma la da el PNG y el color lo pone el CSS (verde), sea cual sea el color del archivo.
// 3. Si no hay ninguno, el texto "KAS:ST" con la tipografía de títulos.
import type { ImageMetadata } from "astro";

const svgs = import.meta.glob<string>("../assets/logo.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const svg = Object.values(svgs)[0];

const pngs = import.meta.glob<ImageMetadata>("../assets/logo-wordmark.png", {
  import: "default",
  eager: true,
});
const png = Object.values(pngs)[0];
---

{
  svg ? (
    <span class="logo logo--svg" role="img" aria-label="KAS:ST" set:html={svg} />
  ) : png ? (
    <span
      class="logo logo--mask"
      role="img"
      aria-label="KAS:ST"
      style={`--logo-url: url(${png.src}); aspect-ratio: ${png.width} / ${png.height}`}
    />
  ) : (
    <span class="logo logo--text display">KAS:ST</span>
  )
}

<style>
  .logo {
    display: inline-block;
    line-height: 1;
    vertical-align: middle;
  }
  .logo--text {
    font-size: 28px;
    letter-spacing: -0.01em;
  }
  .logo--svg :global(svg) {
    display: block;
    height: 26px;
    width: auto;
  }
  .logo--mask {
    height: 26px;
    background-color: currentColor;
    -webkit-mask: var(--logo-url) center / contain no-repeat;
    mask: var(--logo-url) center / contain no-repeat;
  }
  @media (min-width: 768px) {
    .logo--text {
      font-size: 32px;
    }
    .logo--svg :global(svg),
    .logo--mask {
      height: 30px;
    }
  }
</style>
