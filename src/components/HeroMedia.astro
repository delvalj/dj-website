---
// Contenido de la portada: foto o vídeo, según site.hero en src/config/site.ts.
// Si todavía no hay foto en content/photos/hero.jpg, muestra un marcador (degradado oscuro).
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { site } from "../config/site";

const hero = site.hero;

const photos = import.meta.glob<ImageMetadata>("/content/photos/hero.{jpg,jpeg,png,webp}", {
  eager: true,
  import: "default",
});
const photo = Object.values(photos)[0];

if (hero.type === "image" && !photo) {
  console.warn("[hero] Falta content/photos/hero.jpg: se muestra un marcador temporal.");
}
---

{
  hero.type === "video" ? (
    <video
      class="hero-media"
      style={`object-position: ${hero.position}`}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={hero.poster}
      data-hero-video
    >
      {hero.srcMobile && <source src={hero.srcMobile} type="video/mp4" media="(max-width: 767px)" />}
      <source src={hero.src} type="video/mp4" />
    </video>
  ) : photo ? (
    <Picture
      src={photo}
      alt=""
      class="hero-media"
      style={`object-position: ${hero.position}`}
      formats={["avif", "webp"]}
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  ) : (
    <div class="hero-media duo-media placeholder" />
  )
}

<script>
  // Vídeo: si el usuario pidió "reducir movimiento" o "ahorro de datos", se queda en la imagen fija.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (video && (matchMedia("(prefers-reduced-motion: reduce)").matches || saveData)) {
    video.removeAttribute("autoplay");
    video.preload = "none";
    video.pause();
  }
</script>

<style>
  :global(.hero-media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Marcador temporal: un degradado con luces y sombras para que se vea el efecto verde */
  .placeholder {
    background:
      radial-gradient(ellipse 40% 60% at 50% 55%, #9a9a9a 0%, transparent 70%),
      radial-gradient(ellipse 90% 50% at 50% 100%, #555 0%, transparent 70%),
      linear-gradient(180deg, #000 0%, #1a1a1a 45%, #333 100%);
  }
</style>
