---
// Portada: foto o vídeo a todo el ancho con el efecto verde, más el botón del newsletter.
import Duotone from "./Duotone.astro";
import HeroMedia from "./HeroMedia.astro";
import { heroPhoto } from "../config/heroPhoto";
import { site } from "../config/site";
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Título principal de la página: el diseño no lo muestra, pero Google y los lectores de pantalla lo necesitan -->
  <h1 id="hero-title" class="sr-only">{site.name}</h1>
  <Duotone class="hero-frame">
    <HeroMedia />
  </Duotone>

  {!heroPhoto && <p class="hero-note mono">Placeholder — add content/photos/hero.jpg</p>}

  <!-- La ventana del newsletter se conecta en la fase 6 -->
  <button type="button" class="newsletter mono" data-newsletter-open>Join the newsletter</button>
</section>

<style>
  .hero {
    position: relative;
    /* Móvil: casi toda la pantalla, en vertical */
    height: calc(100svh - var(--header-h));
    min-height: 480px;
  }

  .hero :global(.hero-frame) {
    position: absolute;
    inset: 0;
  }

  .hero-note {
    position: absolute;
    top: 16px;
    left: var(--gutter);
    margin: 0;
    padding: 4px 8px;
    font-size: 10px;
    background: var(--black);
  }

  .newsletter {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 24px;
    padding: 18px 24px;
    background: var(--green);
    color: var(--black);
    font-size: 12px;
  }
  .newsletter:hover {
    background: var(--black);
    color: var(--green);
    outline: 1px solid var(--green);
  }

  /* Escritorio: proporción del boceto y botón abajo a la derecha */
  @media (min-width: 768px) {
    .hero {
      height: var(--section-h); /* alto común con NEXT SHOWS y ABOUT (global.css) */
      min-height: 0;
    }
    /* Botón compacto y pegado a la esquina, como en el boceto */
    .newsletter {
      left: auto;
      right: 20px;
      bottom: 20px;
      padding: 12px 48px;
      font-size: 10px;
    }
  }
</style>
