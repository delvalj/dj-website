---
// Sección ABOUT: foto con el efecto verde y la biografía.
// La bio se edita en src/content/bio.md (un párrafo por bloque, separados por una línea en blanco).
// La foto es content/photos/about.jpg (original en color; el efecto lo pone la web).
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Duotone from "./Duotone.astro";
import { Content as Bio } from "../content/bio.md";

const photos = import.meta.glob<ImageMetadata>("/content/photos/about.{jpg,jpeg,png,webp}", {
  eager: true,
  import: "default",
});
const photo = Object.values(photos)[0];
---

<section id="about" class="about">
  <h2 class="display">About</h2>

  <div class="body">
    {
      photo && (
        <Duotone class="about-photo">
          <Picture
            src={photo}
            alt="Portrait of KAS:ST"
            formats={["avif", "webp"]}
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 28vw, 100vw"
          />
        </Duotone>
      )
    }
    <div class="bio">
      <Bio />
    </div>
  </div>
</section>

<style>
  .about {
    border-top: 1px solid var(--green-dim);
    padding: 40px var(--gutter) 48px;
    display: grid;
    gap: 32px;
  }

  .about h2 {
    font-size: clamp(44px, 13vw, 64px);
  }

  .body {
    display: grid;
    gap: 32px;
  }

  .about :global(.about-photo img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* Texto largo: Archivo en su anchura normal, más fácil de leer que la mono en párrafos */
  .bio {
    font-family: var(--font-display);
    font-stretch: 100%;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.6;
    max-width: 62ch;
  }
  .bio :global(p) {
    margin: 0 0 1.2em;
  }
  .bio :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Escritorio: mismo esquema que NEXT SHOWS (título 1/3, contenido 2/3) */
  @media (min-width: 768px) {
    .about {
      grid-template-columns: 1fr 2fr;
      gap: 24px;
      padding: 40px var(--gutter) 56px;
    }
    .about h2 {
      font-size: clamp(40px, 5vw, 72px);
    }
    .body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: start;
    }
    .bio {
      font-size: 15px;
    }
  }
</style>
