---
// Sección ABOUT: foto y biografía, con el layout del PDF del diseñador (v1).
// La bio se edita en src/content/bio.md (un párrafo por bloque, separados por una línea en blanco).
// La foto es content/photos/about.jpg y se muestra tal cual, en su color natural (sin el efecto verde de la portada).
// Escritorio: foto al 50 % del ancho, pegada al borde izquierdo, en 4:5 y con 24 px de negro arriba y abajo.
// A la derecha, el título arriba (alineado con el borde superior de la foto) y la bio en la mitad inferior.
// El alto de la sección lo marca la foto.
// Móvil: foto a todo el ancho (4:5) arriba y debajo el título y la bio.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { Content as Bio } from "../content/bio.md";

const photos = import.meta.glob<ImageMetadata>("/content/photos/about.{jpg,jpeg,png,webp}", {
  eager: true,
  import: "default",
});
const photo = Object.values(photos)[0];
---

<section id="about" class="about">
  {
    photo && (
      <div class="about-photo">
        <Picture
          src={photo}
          alt="Portrait of KAS:ST"
          formats={["avif", "webp"]}
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      </div>
    )
  }
  <div class="text">
    <h2 class="display">About</h2>
    <div class="bio mono">
      <Bio />
    </div>
  </div>
</section>

<style>
  /* ---------- Móvil ---------- */

  /* Recuadro fijo de la foto: 4:5 (a todo el ancho en móvil, 50 % en escritorio).
     La foto lo llena siempre (object-fit: cover) y se recorta si no encaja; el recuadro no cambia.
     --about-focus = qué parte de la foto se mantiene al recortar ("center 20%" = centrada y algo arriba,
     para no cortar la cabeza en fotos verticales). Es lo único que hay que tocar si se cambia la foto. */
  .about-photo {
    --about-focus: center 20%;
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  .about-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--about-focus);
  }
  .about-photo :global(picture) {
    display: contents;
  }

  .text {
    padding: 40px var(--gutter) 48px;
    display: grid;
    gap: 24px;
  }

  .about h2 {
    font-size: clamp(44px, 13vw, 64px); /* igual que NEXT SHOWS */
  }

  /* Bio: mono, mayúsculas, verde, muy pequeña y con interlineado ajustado (medidas del PDF) */
  .bio {
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.1em;
    max-width: 39em; /* unos 56 caracteres por línea, como en el PDF */
  }
  .bio :global(p) {
    margin: 0 0 1.2em; /* una línea en blanco entre párrafos */
  }
  .bio :global(p:last-child) {
    margin-bottom: 0;
  }

  /* ---------- Escritorio ---------- */

  /* Escritorio: el alto de ABOUT lo marca la foto (4:5), no la portada */
  @media (min-width: 768px) {
    .about {
      display: grid;
      grid-template-columns: 1fr 1fr; /* foto 50 % | texto 50 % */
      padding-block: 1.5rem; /* margen negro de 24 px arriba y abajo de la foto */
    }
    /* Recuadro: 50 % del ancho y 4:5, pero nunca más alto que lo que cabe en pantalla
       (ventana - cabecera - los 24 px de arriba y abajo), para que ABOUT se vea entera sin hacer scroll.
       Si 4:5 no cabe, manda ese límite y la foto se recorta (object-fit: cover + --about-focus). */
    .about-photo {
      width: 100%; /* el ancho no se reduce aunque se limite la altura */
      max-height: calc(100svh - var(--header-h) - 3rem);
    }
    .text {
      /* La columna mide lo mismo que la foto y se divide en dos mitades de alto:
         título arriba, en la mitad superior; bio en la mitad inferior. */
      display: flex;
      flex-direction: column;
      padding: 0 3.5vw 0 3.3vw; /* margen izquierdo ~3,3 % y derecho ~3,5 % del ancho */
    }
    .about h2 {
      font-size: var(--title-size); /* igual que NEXT SHOWS; alineado con el borde superior de la foto */
    }
    .bio {
      /* Ocupa la mitad inferior: empieza a media altura de la foto. Si el texto no cabe en esa mitad
         (pantallas más estrechas), la caja crece hacia arriba en vez de alargar la sección. */
      margin-top: auto;
      min-height: 50%;
      max-width: none; /* llega hasta el margen derecho */
      font-size: clamp(11px, 0.85vw, 16px); /* 11 px en pantallas estrechas, crece con el ancho hasta 16 px (como el PDF) */
    }
  }
</style>
