---
// Sección ABOUT: foto y biografía, con el layout del PDF del diseñador (v1).
// La bio se edita en src/content/bio.md (un párrafo por bloque, separados por una línea en blanco).
// La foto es content/photos/about.jpg y se muestra tal cual, en su color natural (sin el efecto verde de la portada).
// Escritorio: dos columnas al 50 %. Foto a la izquierda pegada al borde y a todo el alto; a la derecha,
// el título arriba y la bio abajo, alineada con el borde inferior de la foto.
// Móvil: foto a todo el ancho (4:5) arriba y debajo el título y la bio.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { Content as Bio } from "../content/bio.md";

const photos = import.meta.glob<ImageMetadata>("/content/photos/about.{jpg,jpeg,png,webp}", {
  eager: true,
  import: "default",
});
const photo = Object.values(photos)[0];
---

<section id="about" class="about">
  {
    photo && (
      <div class="about-photo">
        <Picture
          src={photo}
          alt="Portrait of KAS:ST"
          formats={["avif", "webp"]}
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      </div>
    )
  }
  <div class="text">
    <h2 class="display">About</h2>
    <div class="bio mono">
      <Bio />
    </div>
  </div>
</section>

<style>
  /* ---------- Móvil ---------- */

  .about-photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  .about-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%; /* que se vean bien la cabeza y el torso */
  }
  .about-photo :global(picture) {
    display: contents;
  }

  .text {
    padding: 40px var(--gutter) 48px;
    display: grid;
    gap: 24px;
  }

  .about h2 {
    font-size: clamp(44px, 13vw, 64px); /* igual que NEXT SHOWS */
  }

  /* Bio: mono, mayúsculas, verde, muy pequeña y con interlineado ajustado (medidas del PDF) */
  .bio {
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.1em;
    max-width: 39em; /* unos 56 caracteres por línea, como en el PDF */
  }
  .bio :global(p) {
    margin: 0 0 1.2em; /* una línea en blanco entre párrafos */
  }
  .bio :global(p:last-child) {
    margin-bottom: 0;
  }

  /* ---------- Escritorio ---------- */

  @media (min-width: 768px) {
    .about {
      min-height: var(--section-h); /* mismo alto que la portada (global.css) */
      display: grid;
      grid-template-columns: 1fr 1fr; /* foto 50 % | texto 50 % */
    }
    .about-photo {
      aspect-ratio: auto; /* a todo el alto de la sección */
    }
    .about-photo :global(img) {
      position: absolute;
      inset: 0;
    }
    .text {
      grid-column: 2;
      /* Título arriba y bio abajo, con todo el espacio libre entre los dos.
         Márgenes medidos en el PDF respecto a su ancho (1440 px): 26 px arriba y abajo (1,8 %),
         42,6 px a la izquierda (2,96 %) y 52 px a la derecha (3,6 %). */
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 48px;
      padding: 1.8vw 3.6vw 1.8vw 2.96vw;
    }
    .about h2 {
      font-size: var(--title-size);
    }
  }
</style>
