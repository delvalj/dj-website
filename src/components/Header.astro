---
import Logo from "./Logo.astro";

const left = [
  { label: "Home", href: "#top" },
  { label: "Shows", href: "#shows" },
];
const right = [
  { label: "About", href: "#about" },
  { label: "Contact", href: "#contact" },
];
---

<header class="header">
  <nav class="bar" aria-label="Main">
    <ul class="links links--left display">
      {left.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>

    <a href="#top" class="home" aria-label="KAS:ST, back to top"><Logo /></a>

    <ul class="links links--right display">
      {right.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>

    <button
      class="menu-toggle display"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span data-menu-label>Menu</span>
    </button>
  </nav>

  <!-- Menú a pantalla completa (solo móvil). Los iconos sociales se añaden en la fase 5. -->
  <div class="overlay" id="mobile-menu" data-menu hidden>
    <ul class="overlay-links display">
      {[...left, ...right].map((l) => <li><a href={l.href} data-menu-link>{l.label}</a></li>)}
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]")!;
  const label = document.querySelector("[data-menu-label]")!;
  const menu = document.querySelector<HTMLElement>("[data-menu]")!;

  function setOpen(open: boolean) {
    toggle.setAttribute("aria-expanded", String(open));
    label.textContent = open ? "Close" : "Menu";
    menu.hidden = !open;
    document.body.style.overflow = open ? "hidden" : "";
  }

  toggle.addEventListener("click", () => setOpen(menu.hidden));
  menu.querySelectorAll("[data-menu-link]").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
  // Si la ventana pasa a tamaño escritorio, cerrar el menú
  matchMedia("(min-width: 768px)").addEventListener("change", (e) => e.matches && setOpen(false));
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--black);
  }

  .bar {
    height: var(--header-h);
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 10px;
  }
  .links a,
  .overlay-links a,
  .home {
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Móvil: logo a la izquierda y botón MENU a la derecha */
  .links {
    display: none;
  }
  .menu-toggle {
    font-size: 11px;
    padding: 12px 0 12px 12px; /* zona táctil cómoda */
  }

  .overlay {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--black);
    padding: 32px var(--gutter);
    overflow-y: auto;
  }
  .overlay-links {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: clamp(40px, 13vw, 64px);
    display: grid;
    gap: 16px;
  }

  /* Escritorio: como el boceto, HOME/SHOWS | logo | ABOUT/CONTACT */
  @media (min-width: 768px) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .links {
      display: flex;
      gap: clamp(48px, 10vw, 140px);
    }
    .links--right {
      justify-content: flex-end;
    }
    .menu-toggle,
    .overlay {
      display: none;
    }
  }
</style>
