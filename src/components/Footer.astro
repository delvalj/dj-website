---
// Pie de página: iconos de redes, © y enlace a la política de privacidad.
import SocialIcons from "./SocialIcons.astro";
import { site } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <SocialIcons />
  <p class="mono">© {year} {site.name} · <a href="/privacy/">Privacy</a></p>
</footer>

<style>
  .footer {
    /* Footer bajito: iconos y © en una sola fila (también en móvil) */
    padding: 4px var(--gutter);
    background: var(--footer-bg);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 12px;
  }
  .footer p {
    margin: 0;
    font-size: 10px;
  }
  /* Iconos más pequeños en escritorio (con ratón no hace falta tanta zona táctil) */
  @media (min-width: 768px) {
    .footer :global(.social) {
      --icon: 16px;
    }
    .footer :global(.social a) {
      width: 32px;
      height: 32px;
    }
  }
</style>
