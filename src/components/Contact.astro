---
// Sección CONTACT. Los emails se cambian en src/config/site.ts (contact).
// Son enlaces mailto: al tocarlos se abre la app de correo.
// Sección baja: en escritorio, CONTACT a la izquierda y los emails a la derecha, alineados con el texto
// de ABOUT (mitad de la página + 3,3 %), y a la altura del título. En móvil, los emails van debajo del título.
import { site } from "../config/site";

const groups = [
  { label: "Bookings", emails: site.contact.bookings },
  { label: "Management", emails: site.contact.management },
];
---

<section id="contact" class="contact">
  <h2 class="display">Contact</h2>

  <div class="info mono">
    <div class="groups">
      {
        groups.map((g) => (
          <div class="group">
            <h3>{g.label}</h3>
            <ul>
              {g.emails.map((email) => (
                <li>
                  <a href={`mailto:${email}`}>{email}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 56px var(--gutter);
    display: grid;
    gap: 16px;
  }

  .contact h2 {
    font-size: clamp(44px, 13vw, 64px); /* igual que NEXT SHOWS */
  }

  .groups {
    display: grid;
    gap: 16px; /* algo más de aire entre BOOKINGS y MANAGEMENT */
    font-size: 11px;
    line-height: 1.6;
  }

  .info h3 {
    margin: 0;
    font: inherit;
  }

  .info ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Emails en minúsculas, tal y como se escriben */
  .info a {
    display: inline-block;
    padding-block: 5px; /* zona táctil de al menos 24 px de alto */
    text-transform: none;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: transparent; /* el subrayado fino aparece al pasar el ratón */
    transition: text-decoration-color 0.15s;
  }
  .info a:hover,
  .info a:focus-visible {
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .info a {
      transition: none;
    }
  }

  /* Escritorio: CONTACT a la izquierda y los emails en la mitad derecha, como el texto de ABOUT */
  @media (min-width: 768px) {
    .contact {
      grid-template-columns: 1fr 1fr; /* mitades, como ABOUT */
      gap: 0;
      align-items: center; /* emails a la altura del título */
      padding: 64px var(--gutter);
    }
    .contact h2 {
      font-size: var(--title-size);
    }
    /* Los emails empiezan donde empieza el texto de ABOUT: mitad de la página + 3,3 % del ancho */
    .info {
      padding-left: 3.3vw;
      font-size: clamp(12px, 0.9vw, 13px);
    }
    /* BOOKINGS y MANAGEMENT uno al lado del otro (uno debajo de otro si no caben) */
    .groups {
      display: flex;
      flex-wrap: wrap;
      column-gap: 64px;
      row-gap: 16px;
    }
  }
</style>
