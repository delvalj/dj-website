---
// Sección CONTACT. Los emails se cambian en src/config/site.ts (contact).
// Son enlaces mailto: al tocarlos se abre la app de correo.
// Bloque compacto: su ancho lo marca la palabra CONTACT y nada puede ser más ancho que ella.
import { site } from "../config/site";

const groups = [
  { label: "Bookings", emails: site.contact.bookings },
  { label: "Management", emails: site.contact.management },
];
---

<section id="contact" class="contact">
  <div class="block">
    <h2 class="display">Contact</h2>

    <div class="info mono">
      {
        groups.map((g) => (
          <div class="group">
            <h3>{g.label}</h3>
            <ul>
              {g.emails.map((email) => (
                <li>
                  <a href={`mailto:${email}`}>{email}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .contact {
    /* Mucho aire arriba y abajo, pero sección baja */
    padding: 88px var(--gutter);
  }

  /* El bloque mide lo que mide la palabra CONTACT */
  .block {
    width: fit-content;
  }

  .contact h2 {
    font-size: clamp(44px, 13vw, 64px); /* igual que NEXT SHOWS */
  }

  /* width 0 + min-width 100%: el texto de debajo no puede ensanchar el bloque */
  .info {
    width: 0;
    min-width: 100%;
    margin-top: 16px;
    display: grid;
    gap: 16px; /* algo más de aire entre BOOKINGS y MANAGEMENT */
    font-size: 11px;
    line-height: 1.6;
    white-space: nowrap;
  }

  .info h3 {
    margin: 0;
    font: inherit;
  }

  .info ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Emails en minúsculas, tal y como se escriben */
  .info a {
    text-transform: none;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: transparent; /* el subrayado fino aparece al pasar el ratón */
    transition: text-decoration-color 0.15s;
  }
  .info a:hover,
  .info a:focus-visible {
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .info a {
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .contact {
      padding: 128px var(--gutter);
    }
    .contact h2 {
      font-size: var(--title-size); /* igual que NEXT SHOWS en escritorio */
    }
    .info {
      font-size: clamp(12px, 0.9vw, 13px);
    }
  }
</style>
