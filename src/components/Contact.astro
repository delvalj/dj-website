---
// Sección CONTACT. Los emails se cambian en src/config/site.ts (contact).
// Son enlaces mailto: al tocarlos se abre la app de correo.
// Sin líneas: los bloques se separan solo con espacio.
import { site } from "../config/site";

const groups = [
  { label: "Bookings", emails: site.contact.bookings },
  { label: "Management", emails: site.contact.management },
];
---

<section id="contact" class="contact">
  <h2 class="display">Contact</h2>

  <div class="blocks">
    {
      groups.map((g) => (
        <div class="block">
          <h3 class="label mono">{g.label}</h3>
          <ul class="emails">
            {g.emails.map((email) => (
              <li>
                <a href={`mailto:${email}`}>{email}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .contact {
    padding: 64px var(--gutter) 72px;
    display: grid;
    gap: 40px;
  }

  .contact h2 {
    font-size: clamp(44px, 13vw, 64px);
  }

  .blocks {
    display: grid;
    gap: 48px; /* el aire es lo que separa BOOKINGS de MANAGEMENT */
  }

  .label {
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 500;
  }

  .emails {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: clamp(17px, 5.2vw, 24px);
    line-height: 1.3;
  }

  /* Emails grandes, en mono y en minúsculas (tal y como se escriben) */
  .emails a {
    display: inline-block;
    padding: 4px 0; /* zona táctil más cómoda */
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: transparent; /* el subrayado aparece solo al pasar el ratón */
    overflow-wrap: anywhere; /* si no cabe en la pantalla, se parte */
    transition: text-decoration-color 0.25s;
  }
  .emails a:hover,
  .emails a:focus-visible {
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .emails a {
      transition: none;
    }
  }

  /* Escritorio: misma rejilla que NEXT SHOWS (título 1/3, contenido 2/3) */
  @media (min-width: 768px) {
    .contact {
      grid-template-columns: 1fr 2fr;
      gap: 12px;
      padding: 80px var(--gutter) 96px;
    }
    .contact h2 {
      font-size: var(--title-size);
    }
    /* Los bloques van uno al lado del otro si caben enteros; si no, uno debajo de otro */
    .blocks {
      display: flex;
      flex-wrap: wrap;
      align-content: start;
      column-gap: 96px;
      row-gap: 56px;
      padding-left: 14px; /* alineado con el texto de las filas de NEXT SHOWS */
    }
    .block {
      min-width: 0;
    }
    .emails {
      font-size: clamp(20px, 2.2vw, 30px);
    }
  }
</style>
