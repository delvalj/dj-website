---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Header />
  <main id="top">
    <Hero />
    <!-- Secciones provisionales para probar el menú; se sustituyen en las fases 4 y 5 -->
    <section id="shows" class="temp"><h2 class="display">Next<br />Shows</h2><p class="mono">Fase 4</p></section>
    <section id="about" class="temp"><h2 class="display">About</h2><p class="mono">Fase 5</p></section>
    <section id="contact" class="temp"><h2 class="display">Contact</h2><p class="mono">Fase 5</p></section>
  </main>
  <Footer />
</Base>

<style>
  .temp {
    min-height: 80vh;
    padding: 32px var(--gutter);
    border-top: 1px solid var(--green-dim);
  }
  .temp h2 {
    font-size: clamp(40px, 8vw, 72px);
  }
</style>
