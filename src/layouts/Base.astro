---
import "../styles/global.css";
import { site } from "../config/site";

interface Props {
  title?: string;
}

const { title = site.name } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
