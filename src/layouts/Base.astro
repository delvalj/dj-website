---
import "../styles/global.css";
import { site } from "../config/site";

interface Props {
  title?: string;
}

const { title = site.name } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <!-- Las dos fuentes se ven nada más abrir la página: se piden cuanto antes -->
    <link rel="preload" href="/fonts/KASST-Headline-Blk.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/DMMono-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
